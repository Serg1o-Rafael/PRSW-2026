<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="css/estilo.css">
    <title>Cadasto de Clientes</title>
</head>
</head>
<body>
    <header>
        <nav id="menu">
            <a href="/">Home</a> |  <a href="/validaCPF">Verifica CPF</a> | <a href="/confirma">Confirma Senha</a> 
            <a href="/validaCPF">Verifica CPF</a> |

        </nav>
    </header>

    <section>
        <h1 id="titulo">Cadastro de Clientes</h1>
    </section>

    <section id="caixa_formulario">
       <!--  Exibir erros  -->

       <% if(errors.length > 0) %>
            <ul style="color: red;"></ul>
                <% errors.forEach(error => { %>
                    <li><%= error.msg %></li>
                <% }) %>
                </ul>
                <%  %>
                
        <form action="/add_cliente" method="post">
            <label for="nome">Nome</label>
            <input type="text" name="nome" id="nome" value="<%= dadoDigitado.nome%> || '' %>" size="30" maxlength="70">

            <label for="cpf">CPF</label>
            <input type="text" name="cpf" id="cpf" value="<%= dadoDigitado.cpf || '' %>" size="11" maxlength="11">

            <label for="senha">Senha</label>
            <input type="password" name="senha" id="senha" value="<%=dadoDigitado.senha || '' %>" size="8" maxlength="8">

            <label for="confirmasenha">Confirma Senha</label>
            <input type="password" name="confirmasenha" id="confirmasenha" value="<%= dadoDigitado.confirmasenha || '' %>" size="8" maxlength="8">

            <button type="submit">Cadastrar</button>
        </form>
    </section>
</body>
</html>